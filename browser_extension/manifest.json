{
  "manifest_version": 3,
  "name": "動画コマ書き出し - 右クリックで動画を保存",
  "version": "1.1",
  "description": "YouTube・X（Twitter）などの動画を右クリックして、「動画コマ書き出し」アプリで保存します。",
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["http://127.0.0.1:47815/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["patterns.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "save-video": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "マウスの下の動画を保存"
    }
  },
  "action": { "default_title": "このページの動画を保存（動画コマ書き出し）" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
